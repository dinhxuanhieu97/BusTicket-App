# Mã nhà xe mà bản Mini App này phục vụ (mỗi nhà xe một Mini App, cùng mã nguồn).
VITE_OPERATOR_CODE=PN
# Tên hiển thị trên header.
VITE_OPERATOR_NAME=Đặt vé xe Hoài Ân
# Để trống khi chạy dev: gọi `/api` cùng origin, Vite chuyển tiếp sang VITE_API_PROXY_TARGET.
# Khi phát hành: địa chỉ HTTPS của API (API cần bật CORS cho domain Mini App).
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:3001

# Hotline hỗ trợ hiển thị trong mục Cá nhân. Để trống nếu chưa cấu hình.
VITE_SUPPORT_PHONE=0789893955

# Zalo Mini App ID (zmp deploy đọc biến này)
APP_ID=
