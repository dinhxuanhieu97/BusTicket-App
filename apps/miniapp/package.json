  "version": "0.1.0",
  "description": "Zalo Mini App đặt vé xe cho khách (T11). Giao diện riêng theo phong cách app vé máy bay, gọi API công khai của apps/api.",
  "license": "UNLICENSED",
  "browserslist": [
    "Android >= 5",
