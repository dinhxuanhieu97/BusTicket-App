# .env.production.example — Copy thành .env.production và điền giá trị thật
# KHÔNG commit file .env.production lên git!

# --- Database ---
DB_PASSWORD=change_me_strong_password_here

# --- API secrets (mỗi cái >= 32 ký tự ngẫu nhiên) ---
# Sinh bằng: openssl rand -hex 32
BOOKING_TOKEN_SECRET=change_me_booking_secret_at_least_32_chars
AUTH_TOKEN_SECRET=change_me_auth_secret_at_least_32_chars_long

# --- CORS ---
# Các origin được phép gọi API (Mini App Zalo + webapp nếu có)
# Ví dụ: https://miniapp.zalo.me,https://h5.zdn.vn
# Để * khi chạy sau Caddy đã lọc origin (không khuyến khích production)
CORS_ORIGINS=https://miniapp.zalo.me,https://h5.zdn.vn

# --- Proxy ---
# Số tầng reverse proxy phía trước API (Caddy = 1)
TRUST_PROXY=1

# --- Port (khi không dùng Caddy, expose thẳng) ---
API_PORT=3000

# --- SePay ---
# Lấy từ https://my.sepay.vn → Tài khoản ngân hàng → Webhook
SEPAY_API_TOKEN=
